<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.js"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="connection.js"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="index.html"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="loadingSplash.js"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="main.js"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="systemColors.js"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
  </ItemGroup>

</Project>
